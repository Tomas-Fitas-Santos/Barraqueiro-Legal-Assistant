# ── Data ─────────────────────────────────────────────────────────────────────
# Everything the app persists lives here (SQLite DB, file cache, OAuth state).
# Default: ./data-home locally, /data-home in-container.
#LEGAL_DATA_DIR=

# ── Auth (required) ──────────────────────────────────────────────────────────
# HMAC key for session cookies. Long random string; the app cannot sign anyone
# in without it.
LEGAL_SESSION_SECRET=

# First-boot admin. Seeded only when the users table is empty.
LEGAL_BOOTSTRAP_ADMIN_EMAIL=
LEGAL_BOOTSTRAP_ADMIN_PASSWORD=

# ── Secrets at rest ──────────────────────────────────────────────────────────
# Dedicated key for encrypting stored credentials (ChatGPT token, Graph tokens).
# Optional: falls back to LEGAL_SESSION_SECRET (HKDF keeps the keys separate).
#LEGAL_SECRETS_KEY=

# ── AI ───────────────────────────────────────────────────────────────────────
# The primary AI path is a ChatGPT Plus/Pro subscription connected in Settings —
# nothing to configure here. This API key is the configuration-only fallback for
# running without a subscription (billed per token).
#LEGAL_OPENAI_API_KEY=

# ── Web ──────────────────────────────────────────────────────────────────────
# Public origin of this deployment (used for the OAuth browser callback). Unset
# locally: the loopback flow on port 1455 is used instead.
#LEGAL_PUBLIC_BASE_URL=https://barraqueiro-legal.naten.ai

# Cookies: Secure flag auto-detects from X-Forwarded-Proto; set 0/1 to force.
#LEGAL_SECURE_COOKIES=

# Upload cap in MB (default 50).
#LEGAL_MAX_UPLOAD_MB=

# ── Microsoft 365 ────────────────────────────────────────────────────────────
# The app registration (tenant id, client id, client secret) is configured in
# Settings → Microsoft 365, not here — credentials live encrypted in the DB.
# Periodic OneDrive library sync interval in minutes (0/unset = off; the app
# also syncs on login and on "Sync now").
#LEGAL_SYNC_INTERVAL_MINUTES=15
